<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Seule permission demandée : utiliser l'empreinte / le visage pour déverrouiller. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Aucune permission réseau : si une bibliothèque tente d'en ajouter une, elle est retirée.
         ML Kit Document Scanner fonctionne dans le processus des services Google Play. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <!-- Pas de permission CAMERA : le scanner ML Kit gère son propre flux caméra.
         Pas de permission stockage : galerie via Photo Picker, export via Storage Access Framework. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".SecureDocApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SecureDoc"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Partage explicite uniquement (après confirmation), depuis cache/share -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
